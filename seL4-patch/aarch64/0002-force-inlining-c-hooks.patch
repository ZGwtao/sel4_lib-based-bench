From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Guangtao Zhu <guangtaozhu@outlook.com>
Date: Mon, 19 Oct 2026 18:01:00 +1100
Subject: [PATCH] kernel: force inline C entry and exit hooks

Signed-off-by: Guangtao Zhu <guangtaozhu@outlook.com>
---
 include/kernel/traps.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/include/kernel/traps.h b/include/kernel/traps.h
--- a/include/kernel/traps.h
+++ b/include/kernel/traps.h
@@ -14,6 +14,6 @@
 /* This C function should be the first thing called from C after entry from
  * assembly. It provides a single place to do any entry work that is not
  * done in assembly for various reasons */
-static inline void c_entry_hook(void)
+static inline void FORCE_INLINE c_entry_hook(void)
 {
     arch_c_entry_hook();
@@ -26,6 +26,6 @@
  * the kernel (be it to assembly or returning to user space). It provides
  * a place to provide any additional instrumentation or functionality
  * in C before leaving the kernel */
-static inline void c_exit_hook(void)
+static inline void FORCE_INLINE c_exit_hook(void)
 {
 #ifdef CONFIG_BENCHMARK_TRACK_KERNEL_ENTRIES
