From 6c1afab1cbd879e837e58daabfca8ed6d1178507 Mon Sep 17 00:00:00 2001
From: Guangtao Zhu <guangtaozhu@outlook.com>
Date: Fri, 16 Oct 2026 23:10:39 +1100
Subject: [PATCH] aarch64,smp: force inlining getCurrentCPUIndex()

Signed-off-by: Guangtao Zhu <guangtaozhu@outlook.com>
---
 include/arch/arm/arch/64/mode/smp/smp.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/arch/arm/arch/64/mode/smp/smp.h b/include/arch/arm/arch/64/mode/smp/smp.h
index c46872a40..e6e291a5d 100644
--- a/include/arch/arm/arch/64/mode/smp/smp.h
+++ b/include/arch/arm/arch/64/mode/smp/smp.h
@@ -17,7 +17,7 @@ compile_assert(kernel_stack_4k_aligned, KERNEL_STACK_ALIGNMENT == 4096)
 
 #define CPUID_MASK  (KERNEL_STACK_ALIGNMENT - 1)
 
-static inline CONST cpu_id_t
+static inline CONST cpu_id_t FORCE_INLINE
 getCurrentCPUIndex(void)
 {
     cpu_id_t id;
-- 
2.43.0

